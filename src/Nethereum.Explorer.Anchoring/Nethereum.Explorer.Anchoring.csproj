<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />

  <PropertyGroup>
    <Description>Nethereum.Explorer.Anchoring — Pluggable Blazor Server pages for AppChain anchoring monitoring. Razor Class Library — add to any Nethereum Explorer instance via AddAdditionalAssemblies.</Description>
    <AssemblyTitle>Nethereum.Explorer.Anchoring</AssemblyTitle>
    <Version>$(NethereumVersionPreview)</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethereum.Explorer.Anchoring</AssemblyName>
    <PackageId>Nethereum.Explorer.Anchoring</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.Explorer\Nethereum.Explorer.csproj" />
    <ProjectReference Include="..\Nethereum.AppChain.Anchoring.Postgres\Nethereum.AppChain.Anchoring.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NethereumKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <None Include="..\..\NethereumKey.snk" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
