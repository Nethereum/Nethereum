
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />
  <PropertyGroup>
    <Description>Nethereum.Signer.Trezor provides the External Signing capability for Ethereum transactions and Messages using Trezor Hardware wallets</Description>
    <AssemblyTitle>Nethereum.Signer.Trezor</AssemblyTitle>
    <Version>$(NethereumVersion)</Version>
    <TargetFrameworks>net5.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>Nethereum.Signer.Trezor</AssemblyName>
    <PackageId>Nethereum.Signer.Trezor</PackageId>
    <PackageTags>Nethereum;Ethereum;Blockchain;Trezor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.Accounts\Nethereum.Accounts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Device.Net" Version="4.3.0-beta" />
    <PackageReference Include="Device.Net.LibUsb" Version="4.3.0-beta" />
    <PackageReference Include="Hardwarewallets.Net" Version="1.2.0" />
    <PackageReference Include="Hid.Net" Version="4.3.0-beta" />
    <PackageReference Include="protobuf-net" Version="3.2.52" />
    <PackageReference Include="protobuf-net.Reflection" Version="3.2.52" />
    <PackageReference Include="Usb.Net" Version="4.3.0-beta" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net452' Or '$(TargetFramework)' == 'net461'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NethereumKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <None Include="..\..\NethereumKey.snk" />
  </ItemGroup>

</Project>
