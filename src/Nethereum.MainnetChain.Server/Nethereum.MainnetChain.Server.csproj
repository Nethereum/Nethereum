<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ServerFrameworks)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nethereum.MainnetChain.Server</RootNamespace>

    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nethereum-mainnetchain</ToolCommandName>
    <IsPackable>true</IsPackable>

    <Description>Nethereum MainnetChain Server - thin CLI host for the Nethereum.MainnetChain library (read-only mainnet follower + JSON-RPC serving). All composition lives in Nethereum.MainnetChain so it can also be hosted from Aspire or tests.</Description>
    <AssemblyTitle>Nethereum.MainnetChain.Server</AssemblyTitle>
    <Version>$(NethereumVersionPreview)</Version>
    <AssemblyName>Nethereum.MainnetChain.Server</AssemblyName>
    <PackageId>Nethereum.MainnetChain.Server</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.MainnetChain\Nethereum.MainnetChain.csproj" />
    <ProjectReference Include="..\..\aspire\shared\Nethereum.Aspire.ServiceDefaults\Nethereum.Aspire.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Herumi kept as a direct package reference (in addition to the library's) so its native
       runtimes/<rid>/native/libbls_eth.so flows into THIS project's self-contained publish output;
       a transitive project reference does not carry the native asset into publish. -->
  <ItemGroup>
    <PackageReference Include="Nethereum.Signer.Bls.Herumi" Version="$(NethereumVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.12.0-beta.1" />
  </ItemGroup>

  <!-- Prometheus metrics: exports the existing Nethereum.SnapSync Meter (System.Diagnostics.Metrics)
       over an OpenTelemetry Prometheus scraping endpoint. Only active when MetricsPort > 0. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.12.0-beta.1" />
  </ItemGroup>

</Project>
