<Project Sdk="Microsoft.NET.Sdk">
<Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />
<PropertyGroup>
	<Description>Nethereum.EVM.Contracts EVM Simulation of Standard Contracts and Common contracts</Description>
	<AssemblyTitle>Nethereum.EVM.Contracts</AssemblyTitle>
	<Version>$(NethereumVersion)</Version>
	<TargetFrameworks>$(DefaultFrameworks)</TargetFrameworks>
	<AssemblyName>Nethereum.EVM.Contracts</AssemblyName>
	<PackageId>Nethereum.EVM.Contracts</PackageId>
	<PackageTags>Nethereum;Ethereum;Blockchain;EVM</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
</PropertyGroup>
<ItemGroup>
  <ProjectReference Include="..\Nethereum.ABI\Nethereum.ABI.csproj" />
  <ProjectReference Include="..\Nethereum.Hex\Nethereum.Hex.csproj" />
  <ProjectReference Include="..\Nethereum.RPC\Nethereum.RPC.csproj" />
  <ProjectReference Include="..\Nethereum.Contracts\Nethereum.Contracts.csproj" />
  <ProjectReference Include="..\Nethereum.EVM\Nethereum.EVM.csproj" />
  <ProjectReference Include="..\Nethereum.Web3\Nethereum.Web3.csproj" />
</ItemGroup>

<ItemGroup>
  <None Include="README.md" Pack="true" PackagePath="" />
</ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NethereumKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <None Include="..\..\NethereumKey.snk" />
  </ItemGroup>

</Project>
