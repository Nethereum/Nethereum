<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core;assembly=Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core"
             xmlns:conv="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Converters"
             x:Class="Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Views.TieredApprovalView"
             x:DataType="core:TieredApprovalViewModel">
    <UserControl.Resources>
        <conv:BigIntegerToStringConverter x:Key="ToBigIntegerString" />
    </UserControl.Resources>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="3. Tiered approval" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                The account OWNER installs TWO value bands on their account in ONE on-chain call: tier-1
                is a single operator session key capped small; tier-2 is an OwnableValidator N-of-M
                member quorum capped larger, sharing the same cap-policy stack as tier-1 but with its own
                authority and its own, bigger cap. A genuine tier-2 quorum can then pay up to the large
                cap. Three adversarial attempts follow, each rejected by a different gate: too few
                signers is stopped by the tier-2 AUTHORITY (the quorum itself); a genuine quorum asking
                for too much is stopped by the tier-2 CAP POLICY; and the tier-1 operator key, still
                perfectly valid for its own small band, cannot reach into the large-tier band because
                tier-1's own cap stops it first - the tier boundary holds even for a key that is
                otherwise completely legitimate.
            </TextBlock>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Managing user" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding ActiveUserId, TargetNullValue='- none selected -'}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
            </Grid>
            <TextBlock Text="Create or select a user on 1. Create / select user first." Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"
                       IsVisible="{Binding ActiveUserId, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

            <StackPanel Spacing="10" IsVisible="{Binding !IsInstalled}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Tier-1 cap (wei) - operator key" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding SmallCap, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Tier-2 cap (wei) - member quorum" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding LargeCap, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Install tiered roles" Command="{Binding InstallTier2RoleCommand}"
                        IsEnabled="{Binding CanOperate}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding IsInstalled}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tier-1 operator key" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tier-1 permission id" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tier1PermissionIdHex}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tier-2 permission id" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tier2PermissionIdHex}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>

                <TextBlock Text="Tier-2 members" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                <ItemsControl ItemsSource="{Binding MemberAddresses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Quorum pay amount (wei) - within tier-2 cap, above tier-1 cap" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding QuorumPayAmount, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Pay with tier-2 quorum" Command="{Binding PayWithQuorumCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />

                <Button Content="Try under-quorum payment (should be rejected by the AUTHORITY)" Command="{Binding TryUnderQuorumCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Over-cap amount (wei) - above tier-2 cap" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding OverCapAmount, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Try over-cap quorum payment (should be rejected by the CAP POLICY)" Command="{Binding TryOverCapCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />

                <Button Content="Try tier-1 key over its own tier (should be rejected by TIER-1's OWN cap)" Command="{Binding TryTier1OverItsTierCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PayableTarget balance (wei)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetBalance}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Under-quorum rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnderQuorumRejected}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Over-cap rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OverCapRejected}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tier-1-over-its-tier rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Tier1OverItsTierRejected}" FontSize="12" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Working..." FontSize="12" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
