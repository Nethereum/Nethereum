<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core;assembly=Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core"
             x:Class="Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Views.SetupView"
             x:DataType="core:InfrastructureSetupViewModel">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="0. Setup - deploy the AppChain AA stack" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                Setup is where an operator launches or points at the node + bundler and deploys the
                AppChain account-abstraction stack (EntryPoint, AccountRegistry, factory,
                SponsoredPaymaster) plus the enterprise P1-D rule stack (RuleRegistry,
                ValueCapCombinator, PayableTarget) that Admin and User both depend on. Embedded brings up
                an in-process DevChain + bundler for a zero-setup run. External deploys the SAME stack
                against a node + bundler you already run (see run-enterprise-local-stack.ps1), through
                your funder account. Admin and User stay locked until this finishes.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Mode" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding Mode}"
                          IsEnabled="{Binding !IsBusy}" Width="160" />
            </StackPanel>

            <StackPanel Spacing="10"
                        IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:InfrastructureMode.External}}">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}">
                    Deploys the same stack against a node + bundler you already run - real HTTP hops end
                    to end - through your funder account, which pays for every deployment.
                </TextBlock>

                <StackPanel Spacing="4">
                    <TextBlock Text="Node RPC URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding NodeRpcUrl}" Watermark="http://localhost:8545"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Bundler URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding BundlerUrl}" Watermark="http://localhost:4337"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Funder private key" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding FunderPrivateKey}" PasswordChar="*"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <Button Content="{Binding DeployButtonLabel}"
                    Command="{Binding DeployCommand}"
                    IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left"
                    Padding="20,8" />

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Deploying..." FontSize="12" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6" IsVisible="{Binding IsReady}">
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,8" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="EntryPoint" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EntryPointAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="AccountFactory" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountFactoryAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="AccountRegistry" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccountRegistryAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SponsoredPaymaster" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SponsoredPaymasterAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ValueCapCombinator" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ValueCapCombinatorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="PayableTarget" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PayableTargetAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
