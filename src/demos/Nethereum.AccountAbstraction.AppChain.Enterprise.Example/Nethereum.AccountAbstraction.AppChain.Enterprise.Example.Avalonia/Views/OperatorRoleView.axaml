<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core;assembly=Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core"
             xmlns:conv="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Converters"
             x:Class="Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Views.OperatorRoleView"
             x:DataType="core:EnterpriseOperatorViewModel">
    <UserControl.Resources>
        <conv:BigIntegerToStringConverter x:Key="ToBigIntegerString" />
    </UserControl.Resources>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="2. User - operate a capped role" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                The account OWNER (the enrolled user themself) installs a tier-1 role on their own
                account - a session key capped by the P1-D ValueCapCombinator policy - then uses it to
                pay a target contract. Paying within the cap succeeds; paying over the cap is rejected
                on-chain by the policy, not merely client-side. This tab never uses the org's admin key.
            </TextBlock>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Managing user" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding ActiveUserId, TargetNullValue='- none selected -'}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
            </Grid>
            <TextBlock Text="Create or select a user on 1. Create / select user first." Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"
                       IsVisible="{Binding ActiveUserId, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

            <StackPanel Spacing="10" IsVisible="{Binding !HasCappedRole}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Cap (wei)" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding Cap, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Install capped role" Command="{Binding InstallCappedRoleCommand}"
                        IsEnabled="{Binding CanOperate}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding HasCappedRole}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Session key" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SessionKeyAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Permission id" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PermissionIdHex}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Within-cap amount (wei)" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding WithinCapAmount, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Pay within cap" Command="{Binding PayWithinCapCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Over-cap amount (wei)" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding OverCapAmount, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Try over-cap payment (should be rejected)" Command="{Binding TryOverCapCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PayableTarget balance (wei)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetBalance}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Over-cap rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OverCapRejected}" FontSize="12" />
                </Grid>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                    SmartSession installs once per account, so there is no in-place edit: Edit cap re-issues
                    the role at a new cap - a brand new session key, the old one dies. Revoke role uninstalls
                    the role outright - the session key becomes dead.
                </TextBlock>

                <StackPanel Spacing="4">
                    <TextBlock Text="New cap (wei)" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding NewCap, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Edit cap" Command="{Binding EditCapCommand}"
                            IsEnabled="{Binding !IsBusy}" Classes="accent" Padding="20,8" />
                    <Button Content="Revoke role" Command="{Binding RevokeRoleCommand}"
                            IsEnabled="{Binding !IsBusy}" Padding="20,8" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Working..." FontSize="12" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
