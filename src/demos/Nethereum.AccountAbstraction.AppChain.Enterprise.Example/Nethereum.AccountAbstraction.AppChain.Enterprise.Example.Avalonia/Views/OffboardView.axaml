<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core;assembly=Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Core"
             xmlns:conv="clr-namespace:Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Converters"
             x:Class="Nethereum.AccountAbstraction.AppChain.Enterprise.Example.Avalonia.Views.OffboardView"
             x:DataType="core:OffboardViewModel">
    <UserControl.Resources>
        <conv:BigIntegerToStringConverter x:Key="ToBigIntegerString" />
    </UserControl.Resources>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="4. Offboard" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                A guided, two-phase severance walk for a single enrolled user, in order, showing WHICH
                actor acts at each step. Set up (the account OWNER) installs a tier-1 capped session and
                a 2-of-3 GUARDIAN quorum, then proves the session is live with a baseline pay. Rotate
                owner (the GUARDIAN quorum) moves ownership to a fresh key - the old owner is proven dead
                (AA24) on the account it used to control. Revoke session (the NEW owner) removes the
                tier-1 session - the session key that just paid is proven dead (InvalidPermissionId).
                Uninstall module (the NEW owner) removes the SmartSession module entirely. Sweep (the NEW
                owner) moves the account's remaining balance to a fresh treasury address. Ban (the ORG
                ADMIN) marks the account inactive on the registry. Each step is only available once the
                step before it has completed.
            </TextBlock>

            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Managing user" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding ActiveUserId, TargetNullValue='- none selected -'}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
            </Grid>
            <TextBlock Text="Create or select a user on 1. Create / select user first." Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"
                       IsVisible="{Binding ActiveUserId, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

            <StackPanel Spacing="10" IsVisible="{Binding !IsSetUp}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Tier-1 session cap (wei)" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding Cap, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Baseline pay amount (wei) - proves the session is live" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding WithinCapAmount, Converter={StaticResource ToBigIntegerString}, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}" Width="200" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Content="Set up (OWNER: install session + guardians, baseline pay)" Command="{Binding SetUpAccountCommand}"
                        IsEnabled="{Binding CanOperate}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding IsSetUp}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Session key" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SessionKeyAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Permission id" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PermissionIdHex}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>

                <TextBlock Text="Guardians" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                <ItemsControl ItemsSource="{Binding GuardianAddresses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <Button Content="Rotate owner (GUARDIAN quorum: rotate ownership, old owner should die)" Command="{Binding RotateOwnerCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8"
                        IsVisible="{Binding !IsRotated}" />

                <StackPanel Spacing="10" IsVisible="{Binding IsRotated}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="New owner" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NewOwnerAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Old owner rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OldOwnerRejected}" FontSize="12" />
                    </Grid>

                    <Button Content="Revoke session (NEW owner: remove tier-1 session, session should die)" Command="{Binding RevokeSessionCommand}"
                            IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8"
                            IsVisible="{Binding !IsSessionRevoked}" />

                    <StackPanel Spacing="10" IsVisible="{Binding IsSessionRevoked}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Revoked session rejected?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RevokedSessionRejected}" FontSize="12" />
                        </Grid>

                        <Button Content="Uninstall module (NEW owner: remove SmartSession module)" Command="{Binding UninstallModuleCommand}"
                                IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8"
                                IsVisible="{Binding !IsModuleUninstalled}" />

                        <StackPanel Spacing="10" IsVisible="{Binding IsModuleUninstalled}">
                            <Button Content="Sweep (NEW owner: move remaining balance to fresh treasury)" Command="{Binding SweepCommand}"
                                    IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8"
                                    IsVisible="{Binding !IsSwept}" />

                            <StackPanel Spacing="10" IsVisible="{Binding IsSwept}">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Treasury address" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TreasuryAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Swept amount (wei)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SweptAmount}" FontSize="12" />
                                </Grid>

                                <Button Content="Ban (ORG ADMIN: mark account inactive on the registry)" Command="{Binding BanCommand}"
                                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8"
                                        IsVisible="{Binding !IsBanned}" />

                                <TextBlock Text="Offboard complete - the account is banned and inactive on the registry."
                                           Foreground="#7fd99b" FontSize="13" TextWrapping="Wrap"
                                           IsVisible="{Binding IsBanned}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PayableTarget balance (wei)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetBalance}" FontSize="12" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Working..." FontSize="12" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
