<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.Example.Core;assembly=Nethereum.AccountAbstraction.Example.Core"
             x:Class="Nethereum.AccountAbstraction.Example.Avalonia.Views.InfrastructureView"
             x:DataType="core:InfrastructureSetupViewModel">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Setup infra - deploy the AA stack" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                Nethereum ships a full ERC-4337 bundler (Nethereum.AccountAbstraction.Bundler), not just
                a client. Embedded runs that bundler in-process against an in-process DevChain for
                zero-setup testing. External points the SAME client + bundler API at your own node +
                bundler - test-local vs real infra is just a different endpoint plus a funder key. Use
                existing points that same client at ANY provider's already-deployed standard ERC-7579
                modules - client-side interop testing - and deploys only this demo's own target
                contracts. Nothing runs until you click Deploy; every other tab is disabled until this
                finishes.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Mode" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding Mode}"
                          IsEnabled="{Binding !IsBusy}" Width="160" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}"
                       IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:InfrastructureMode.Embedded}}">
                Brings up an in-process ERC-4337 bundler + DevChain, then deploys the full ERC-7579
                stack - EntryPoint, factory, validators, modules, demo contracts, and a funded
                sponsoring paymaster.
            </TextBlock>

            <StackPanel Spacing="10"
                        IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:InfrastructureMode.External}}">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}">
                    Deploys the same stack against a node + bundler you already run. The EntryPoint
                    your bundler already supports is reused if it's on-chain, otherwise a fallback is
                    deployed through the funder account. The funder pays for every deployment and
                    every faucet transfer.
                </TextBlock>

                <StackPanel Spacing="4">
                    <TextBlock Text="Node RPC URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding NodeRpcUrl}" Watermark="http://localhost:8545"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Bundler URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding BundlerUrl}" Watermark="http://localhost:4337"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Funder private key" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding FunderPrivateKey}" PasswordChar="*"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10"
                        IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:InfrastructureMode.UseExisting}}">
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}">
                    Connects the SAME client + bundler API to a PROVIDER's already-deployed standard
                    ERC-7579 modules below - client-side interop testing - and deploys only this demo's
                    own target contracts (TestCounter, BookingRegistry) through the funder account. There
                    is no paymaster in this mode, so Gasless is unavailable.
                </TextBlock>

                <StackPanel Spacing="4">
                    <TextBlock Text="Node RPC URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding NodeRpcUrl}" Watermark="http://localhost:8545"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Bundler URL" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding BundlerUrl}" Watermark="http://localhost:4337"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Funder private key" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding FunderPrivateKey}" PasswordChar="*"
                              IsEnabled="{Binding !IsBusy}" Width="400" HorizontalAlignment="Left" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />
                <TextBlock Text="Provider's already-deployed standard module addresses" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="EntryPoint" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingEntryPointAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="NethereumAccountFactory" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingFactoryAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="ECDSAValidator" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingEcdsaValidatorAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="WebAuthnValidator" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingWebAuthnValidatorAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="OwnableExecutor" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingOwnableExecutorAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="SocialRecovery" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingSocialRecoveryAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="SmartSession" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingSmartSessionAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="SudoPolicy" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingSudoPolicyAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="UniActionPolicy" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingUniActionPolicyAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="ECDSASessionValidator" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingEcdsaSessionValidatorAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="NethereumAccount implementation" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Text="{Binding ExistingAccountImplementationAddress}" IsEnabled="{Binding !IsBusy}" Width="440" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <Button Content="{Binding DeployButtonLabel}"
                    Command="{Binding DeployCommand}"
                    IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left"
                    Padding="20,8" />

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Deploying..." FontSize="12" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6" IsVisible="{Binding IsReady}">
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,8" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="EntryPoint" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EntryPointAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="NethereumAccountFactory" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FactoryAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ECDSAValidator" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EcdsaValidatorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="WebAuthnValidator" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WebAuthnValidatorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="OwnableExecutor" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OwnableExecutorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="SocialRecovery" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SocialRecoveryAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="SmartSession" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SmartSessionAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="VerifyingPaymaster" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PaymasterAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
