<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.Example.Core;assembly=Nethereum.AccountAbstraction.Example.Core"
             x:Class="Nethereum.AccountAbstraction.Example.Avalonia.Views.SetupView"
             x:DataType="core:SetupViewModel">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Setup - create a smart account" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                Generates a fresh owner key and derives the account's counterfactual (CREATE2) address
                through IAAClient.CreateAccountAsync. No transaction is sent yet - the
                account deploys itself the first time a call goes through it.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Payment mode" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailablePaymentModes}" SelectedItem="{Binding SelectedPaymentMode}"
                          IsEnabled="{Binding !IsBusy}" Width="200" />
            </StackPanel>
            <TextBlock Text="No paymaster is configured for this infrastructure (use-existing mode); the new account will be self-funded."
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}"
                       IsVisible="{Binding !HasPaymaster}" />

            <Button Content="Create Account" Command="{Binding CreateAccountCommand}"
                    IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left"
                    Padding="20,8" />

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Creating..." FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding SmartAccountAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Owner address" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OwnerAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Smart account address" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SmartAccountAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Deployed?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Yes" IsVisible="{Binding IsDeployed}" FontSize="12" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="No - deploys on its first operation" IsVisible="{Binding !IsDeployed}" FontSize="12" />
                </Grid>

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />
            </StackPanel>

            <!-- Gated on HasActiveAccount (the session's active account), not SmartAccountAddress:
                 whichever tab created the active account (Setup or Passkey), it can be funded here
                 without minting an unrelated new one by clicking "Create Account" again. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasActiveAccount}">
                <TextBlock Text="{Binding ActiveAccountAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="{Binding !ActiveAccountIsPaymasterSponsored}">
                    The active account above starts at zero balance. Fund it before trying the Send,
                    Batch or Custom Contract tabs (they pay their own gas) - or skip funding and go
                    straight to Gasless, which works even at zero balance because a paymaster
                    sponsors it.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="{Binding ActiveAccountIsPaymasterSponsored}">
                    This account is paymaster-sponsored - the paymaster covers gas for Send, Batch and
                    Custom Contract too, so funding isn't needed (same mechanism as the Gasless tab).
                </TextBlock>
                <Button Content="Fund account" Command="{Binding FundAccountCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
