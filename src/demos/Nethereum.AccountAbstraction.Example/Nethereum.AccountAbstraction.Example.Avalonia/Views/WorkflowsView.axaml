<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.Example.Core;assembly=Nethereum.AccountAbstraction.Example.Core"
             x:Class="Nethereum.AccountAbstraction.Example.Avalonia.Views.WorkflowsView"
             x:DataType="core:WorkflowsViewModel">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Workflows - ERC-7579 OwnableExecutor" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                Delegated automation: an OwnableExecutor module lets a SEPARATE agent EOA act on your
                account WITHOUT your account signing each operation - no UserOperation, no owner
                signature. Create the agent, grant it executor rights, then watch it call count() on
                your behalf directly. A different, unauthorized EOA trying the same call is rejected by
                the executor's own owner check.
            </TextBlock>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Module (OwnableExecutor)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExecutorAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
            </Grid>

            <!-- No agent yet: only the create action is available. -->
            <StackPanel Spacing="10" IsVisible="{Binding AgentAddress, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                <Button Content="Create automation agent" Command="{Binding CreateAgentCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left"
                        Padding="20,8" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding AgentAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Automation agent" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AgentAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Executor installed?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Yes - the agent can act on your account" IsVisible="{Binding IsExecutorInstalled}" FontSize="12" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="No" IsVisible="{Binding !IsExecutorInstalled}" FontSize="12" />
                </Grid>

                <!-- Agent created but not yet granted executor rights. -->
                <StackPanel Spacing="10" IsVisible="{Binding !IsExecutorInstalled}">
                    <Button Content="Grant the agent executor rights" Command="{Binding InstallExecutorCommand}"
                            IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />
                </StackPanel>

                <!-- Executor installed: run the delegated action, try an unauthorized one, then revoke. -->
                <StackPanel Spacing="10" IsVisible="{Binding IsExecutorInstalled}">
                    <Button Content="Run delegated action (agent calls count())" Command="{Binding RunDelegatedActionCommand}"
                            IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />

                    <Button Content="Try unauthorized action (different EOA)" Command="{Binding TryUnauthorizedActionCommand}"
                            IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />

                    <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                    <Button Content="Revoke executor" Command="{Binding UninstallExecutorCommand}"
                            IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Working..." FontSize="12" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  IsVisible="{Binding LastDelegatedTxHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Delegated tx hash" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastDelegatedTxHash}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Counter (via delegated agent)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Count}" FontSize="12" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  IsVisible="{Binding LastReceipt, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="UserOp hash" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastReceipt.UserOpHash}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Success?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastReceipt.UserOpSuccess}" FontSize="12" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
