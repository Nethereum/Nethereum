<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Nethereum.AccountAbstraction.Example.Core;assembly=Nethereum.AccountAbstraction.Example.Core"
             x:Class="Nethereum.AccountAbstraction.Example.Avalonia.Views.ModulesView"
             x:DataType="core:ModulesViewModel">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Modules - ERC-7579 install/uninstall" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="13">
                ERC-7579 modules: install or uninstall capabilities on your account, live. This demo adds
                the deployed WebAuthnValidator as a SECOND validator on your active account (created on
                the Setup tab, still owned by its original ECDSA key), proves the account can then be
                authorised by that passkey, then removes it again - your account gains, and loses, a
                signer.
            </TextBlock>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Module (WebAuthnValidator)" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModuleAddress}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Installed?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Yes - a second validator on your account" IsVisible="{Binding IsPasskeyValidatorInstalled}" FontSize="12" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="No" IsVisible="{Binding !IsPasskeyValidatorInstalled}" FontSize="12" />
            </Grid>

            <!-- Not installed yet: only the install action is available. -->
            <StackPanel Spacing="10" IsVisible="{Binding !IsPasskeyValidatorInstalled}">
                <Button Content="Install passkey as second validator" Command="{Binding InstallPasskeyValidatorCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left"
                        Padding="20,8" />
            </StackPanel>

            <!-- Installed: prove the module validates, then remove it again. -->
            <StackPanel Spacing="10" IsVisible="{Binding IsPasskeyValidatorInstalled}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto"
                      IsVisible="{Binding CredentialId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Passkey credential id" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CredentialId}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                </Grid>

                <Button Content="Prove passkey can sign (Count via passkey)" Command="{Binding ProvePasskeyCanSignCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="accent" HorizontalAlignment="Left" Padding="20,8" />

                <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                <Button Content="Uninstall passkey validator" Command="{Binding UninstallPasskeyValidatorCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="20,8" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" />
                <TextBlock Text="Working..." FontSize="12" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  IsVisible="{Binding LastReceipt, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="UserOp hash" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastReceipt.UserOpHash}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Success?" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastReceipt.UserOpSuccess}" FontSize="12" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#7fd99b"
                       FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff8080"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
