<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExternalInfrastructureProvisionerTests stands up a real DevChain HTTP server -
         Nethereum.DevChain's own FrameworkReference does not flow far enough for
         WebApplication.CreateBuilder() to resolve here, so it is declared directly too. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.AccountAbstraction.Example.Core\Nethereum.AccountAbstraction.Example.Core.csproj" />
    <ProjectReference Include="..\Nethereum.AccountAbstraction.Example.Hosting\Nethereum.AccountAbstraction.Example.Hosting.csproj" />
    <ProjectReference Include="..\..\..\Nethereum.AccountAbstraction.Bundler.InProcess\Nethereum.AccountAbstraction.Bundler.InProcess.csproj" />
    <!-- Only reference for ExternalInfrastructureProvisionerTests' own real HTTP bundler host
         (Nethereum.AccountAbstraction.Bundler.RpcServer.AddBundlerRpcServer) - the demo itself never
         depends on this package; it is test-only infrastructure for exercising the External code
         path without a real external node. -->
    <ProjectReference Include="..\..\..\Nethereum.AccountAbstraction.Bundler.RpcServer\Nethereum.AccountAbstraction.Bundler.RpcServer.csproj" />
    <!-- NethereumDocExampleAttribute, for tagging the tests the smart-sessions-and-policies doc guide
         is grounded in. -->
    <ProjectReference Include="..\..\..\Nethereum.Documentation\Nethereum.Documentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
