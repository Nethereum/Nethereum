<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ServerFrameworks)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Nethereum.Node.HarnessServer</RootNamespace>

    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>

    <Description>Nethereum node entrypoint for benchmark/conformance harnesses (benchmarkoor, hive) - boots from a standard EL genesis.json and geth-style CLI flags, and serves JSON-RPC + a JWT-authenticated Engine API.</Description>
    <AssemblyTitle>Nethereum.Node.HarnessServer</AssemblyTitle>
    <Version>$(NethereumVersion)</Version>
    <AssemblyName>Nethereum.Node.HarnessServer</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.DevChain\Nethereum.DevChain.csproj" />
    <ProjectReference Include="..\Nethereum.EVM.Precompiles.Bls\Nethereum.EVM.Precompiles.Bls.csproj" />
    <ProjectReference Include="..\Nethereum.EVM.Precompiles.Kzg\Nethereum.EVM.Precompiles.Kzg.csproj" />
    <ProjectReference Include="..\Nethereum.Signer.Bls.Herumi\Nethereum.Signer.Bls.Herumi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Nethereum.Signer.Bls.Herumi\runtimes\linux-x64\native\libbls_eth.so">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
