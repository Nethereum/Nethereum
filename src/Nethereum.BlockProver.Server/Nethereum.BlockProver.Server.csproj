<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />
  <PropertyGroup>
    <Description>Nethereum BlockProver Server - hosts the block-proving loop (witness to proof) over the CoreChain proving primitives, with retention, cadence, retries and metrics</Description>
    <AssemblyTitle>Nethereum.BlockProver.Server</AssemblyTitle>
    <Version>$(NethereumVersion)</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ServerFrameworks)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nethereum.BlockProver.Server</AssemblyName>
    <PackageId>Nethereum.BlockProver.Server</PackageId>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.CoreChain\Nethereum.CoreChain.csproj" />
    <ProjectReference Include="..\Nethereum.BlockchainProcessing\Nethereum.BlockchainProcessing.csproj" />
    <ProjectReference Include="..\Nethereum.DevChain\Nethereum.DevChain.csproj" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NethereumKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <None Include="..\..\NethereumKey.snk" />
  </ItemGroup>

</Project>
