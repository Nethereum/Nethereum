<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), dir.props))\dir.props" />

  <PropertyGroup>
    <Description>Nethereum AccountAbstraction Bundler InProcess - in-process DevChain + bundler bootstrap for tests and examples</Description>
    <AssemblyTitle>Nethereum.AccountAbstraction.Bundler.InProcess</AssemblyTitle>
    <Version>$(NethereumVersion)</Version>
    <TargetFrameworks>$(AppChainFrameworks)</TargetFrameworks>
    <AssemblyName>Nethereum.AccountAbstraction.Bundler.InProcess</AssemblyName>
    <PackageId>Nethereum.AccountAbstraction.Bundler.InProcess</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.AccountAbstraction.Bundler\Nethereum.AccountAbstraction.Bundler.csproj" />
    <ProjectReference Include="..\Nethereum.DevChain\Nethereum.DevChain.csproj" />
    <ProjectReference Include="..\Nethereum.Util\Nethereum.Util.csproj" />
    <!-- DevChain pulls Microsoft.Extensions.Hosting.Abstractions 10.0.0 (>= net8.0) unconditionally,
         which needs Logging.Abstractions >= 10.0.0; float the floor up to match and avoid NU1605. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.0,)" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NethereumKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net35' And '$(TargetUnityNet461AOT)' != 'true'">
    <None Include="..\..\NethereumKey.snk" />
  </ItemGroup>

</Project>
