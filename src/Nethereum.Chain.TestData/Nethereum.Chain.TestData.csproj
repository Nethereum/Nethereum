<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Nethereum.Chain.TestData</RootNamespace>
    <Description>Shared chain test data: the bulk setup (accounts, funding, genesis allocation) and the per-EIP transaction scenario catalogue, consumed by every end-to-end suite - AppChain (full stack), DevP2P (propagation) and DevChain (AA). One place to add an EIP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethereum.Model\Nethereum.Model.csproj" />
    <ProjectReference Include="..\Nethereum.Signer\Nethereum.Signer.csproj" />
    <ProjectReference Include="..\Nethereum.CoreChain\Nethereum.CoreChain.csproj" />
    <ProjectReference Include="..\Nethereum.Contracts\Nethereum.Contracts.csproj" />
  </ItemGroup>

</Project>
