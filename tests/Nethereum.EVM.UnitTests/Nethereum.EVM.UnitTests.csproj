    <ItemGroup>
    <!-- One statement of what a block executor must do about system calls,
         compiled into both twins' suites. The two executors live in different
         assemblies, so nothing can compare them directly; sharing the
         expectation is what stops them drifting silently. -->
    <Compile Include="..\Nethereum.EVM.Core.Tests\GeneralStateTests\SystemCallExpectations.cs"
             Link="GeneralStateTests\SystemCallExpectations.cs" />

    <!-- AMS-REJ-02. ONE rejection matcher for the whole repo: the host runner, the
         guest runner and this project's state-test runner all score expectException
         through the same table, so a fixture's demanded reason cannot be satisfied by
         three different answers. -->
    <Compile Include="..\Nethereum.CoreChain.IntegrationTests\BlockchainTests\ExpectedRejectionMatcher.cs"
             Link="BlockchainTests\ExpectedRejectionMatcher.cs" />
  </ItemGroup>

