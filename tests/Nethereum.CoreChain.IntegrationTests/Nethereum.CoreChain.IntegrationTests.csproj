<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Nethereum.CoreChain.IntegrationTests - E2E tests for CoreChain</Description>
    <Authors>JuanFran</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethereum.CoreChain.IntegrationTests</AssemblyName>
    <PackageId>Nethereum.CoreChain.IntegrationTests</PackageId>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nethereum.CoreChain\Nethereum.CoreChain.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Zisk.Prover.Server\Nethereum.Zisk.Prover.Server.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\Nethereum.CoreChain.RocksDB\Nethereum.CoreChain.RocksDB.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.DevChain\Nethereum.DevChain.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Node.HarnessServer\Nethereum.Node.HarnessServer.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Signer\Nethereum.Signer.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.ABI\Nethereum.ABI.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Contracts\Nethereum.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Web3\Nethereum.Web3.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Accounts\Nethereum.Accounts.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.KeyStore\Nethereum.KeyStore.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Merkle.Binary\Nethereum.Merkle.Binary.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Merkle.Patricia\Nethereum.Merkle.Patricia.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Documentation\Nethereum.Documentation.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.BlockchainProcessing\Nethereum.BlockchainProcessing.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM\Nethereum.EVM.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM.Precompiles.Kzg\Nethereum.EVM.Precompiles.Kzg.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM.Precompiles.Bls\Nethereum.EVM.Precompiles.Bls.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Signer.Bls\Nethereum.Signer.Bls.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Signer.Bls.Herumi\Nethereum.Signer.Bls.Herumi.csproj" />
  </ItemGroup>

  <!-- Herumi ships libbls_eth as a native asset under runtimes/<rid>/native. A
       project reference does not flow it into the test output, so it is copied
       explicitly — without it the BLS12-381 backend cannot load and the
       Amsterdam host fixtures fall straight back into the unwired-precompile
       divergence HostBlockchainTestRunner.FixtureRegistry exists to prevent. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\..\src\Nethereum.Signer.Bls.Herumi\runtimes\win-x64\native\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
