<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Isolated in-process EEST conformance runner.

    Composes the REAL node (Nethereum.DevChain's DevChainNode/BlockManager - the same composition
    src/Nethereum.Node.HarnessServer/HarnessNodeHost.cs uses), not a CoreChain-only approximation.
    Referencing Nethereum.DevChain was off-limits when this project was first created (the DevChain/
    DevP2P.Sync merge was still broken); it is resolved as of 6db78472e, so the full node is used
    here directly - only the ASP.NET WebApplication/HTTP/JSON-RPC layer is skipped, since a
    conformance case calls BlockImporter in-process rather than over HTTP.
  -->

  <PropertyGroup>
    <Description>Nethereum.EEST.ConformanceRunner - in-process EEST blockchain_tests conformance gate</Description>
    <Authors>JuanFran</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethereum.EEST.ConformanceRunner</AssemblyName>
    <PackageId>Nethereum.EEST.ConformanceRunner</PackageId>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- DevChain.csproj carries FrameworkReference Microsoft.AspNetCore.App itself (WebApplicationExtensions.cs
         lives in the same assembly as DevChainNode/BlockManager); declared again here so this
         project's own runtime resolves the shared framework too. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Nethereum.DevChain\Nethereum.DevChain.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.CoreChain\Nethereum.CoreChain.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM\Nethereum.EVM.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM.Precompiles.Kzg\Nethereum.EVM.Precompiles.Kzg.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.EVM.Precompiles.Bls\Nethereum.EVM.Precompiles.Bls.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Signer.Bls\Nethereum.Signer.Bls.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Signer.Bls.Herumi\Nethereum.Signer.Bls.Herumi.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.RLP\Nethereum.RLP.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Merkle.Patricia\Nethereum.Merkle.Patricia.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Model\Nethereum.Model.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Util\Nethereum.Util.csproj" />
    <ProjectReference Include="..\..\src\Nethereum.Hex\Nethereum.Hex.csproj" />
    <!-- FilterLog (state_tests post.logs hash check) and TransactionExecutor's own log
         type already flow in transitively via Nethereum.EVM/Nethereum.CoreChain, but the
         state_tests driver names Nethereum.RPC.Eth.DTOs directly, so it is declared here too. -->
    <ProjectReference Include="..\..\src\Nethereum.RPC\Nethereum.RPC.csproj" />
  </ItemGroup>

  <!-- Herumi ships libbls_eth as a native asset under runtimes/<rid>/native. A project
       reference does not flow it into the test output, so it is copied explicitly -
       without it the BLS12-381 backend cannot load. See
       tests\Nethereum.CoreChain.IntegrationTests\Nethereum.CoreChain.IntegrationTests.csproj
       for the same pattern. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\..\src\Nethereum.Signer.Bls.Herumi\runtimes\win-x64\native\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <None Include="..\..\src\Nethereum.Signer.Bls.Herumi\runtimes\linux-x64\native\*.so">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
