ARG ZISK_VERSION=1.3.1-alpha
ARG BFLAT_IMAGE=nethereum/bflat-riscv64:zisk-1.3.1
ARG DOTNET_SDK_CHANNEL=10.0
ARG DOTNET_RUNTIME_CHANNELS="8.0"

FROM ubuntu:24.04 AS zisk-runtime-libs
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl tar gzip libgomp1 libsodium23 libgmp10 \
      libopenmpi3t64 openmpi-bin openmpi-common libhwloc15 libnuma1 \
 && rm -rf /var/lib/apt/lists/*

FROM zisk-runtime-libs AS zisk-bundle
ARG ZISK_VERSION
RUN curl -fsSL "https://raw.githubusercontent.com/0xPolygonHermez/zisk/v${ZISK_VERSION}/ziskup/ziskup" -o /usr/local/bin/ziskup \
 && chmod +x /usr/local/bin/ziskup \
 && ziskup --system --prefix /opt/zisk --version "${ZISK_VERSION}" --gpu --nokey --yes && chmod -R a+rX /opt/zisk

FROM zisk-runtime-libs AS libziskos
ARG ZISK_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends git build-essential make python3 pkg-config libssl-dev xz-utils clang libclang-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
COPY --from=zisk-bundle /opt/zisk/bin /root/.zisk/bin
ENV PATH=/root/.zisk/bin:/root/.cargo/bin:$PATH
RUN cargo-zisk toolchain install
COPY build-libziskos.sh /build/zisk/scripts/build-libziskos.sh
RUN LIBZISKOS_OUT=/out bash /build/zisk/scripts/build-libziskos.sh "v${ZISK_VERSION}"

FROM ${BFLAT_IMAGE} AS bflat

FROM zisk-runtime-libs
ARG DOTNET_SDK_CHANNEL
ARG DOTNET_RUNTIME_CHANNELS

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git build-essential python3 python3-pip procps libjemalloc2 libicu74 libssl3t64 zlib1g \
      binutils-riscv64-linux-gnu gcc-riscv64-linux-gnu llvm libomp5-18 nodejs npm \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --break-system-packages lief pyelftools

ENV DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PATH=/usr/share/dotnet:/share/bflat:/opt/zisk/bin:$PATH

RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && bash /tmp/dotnet-install.sh --channel "$DOTNET_SDK_CHANNEL" --install-dir /usr/share/dotnet \
 && for channel in $DOTNET_RUNTIME_CHANNELS; do \
      bash /tmp/dotnet-install.sh --channel "$channel" --runtime dotnet --install-dir /usr/share/dotnet; \
      bash /tmp/dotnet-install.sh --channel "$channel" --runtime aspnetcore --install-dir /usr/share/dotnet; \
    done \
 && rm /tmp/dotnet-install.sh

RUN npm install --prefix /opt/snarkjs snarkjs@0.7.6

COPY --from=bflat /share/bflat /share/bflat
COPY --from=libziskos /out /opt/libziskos
COPY --from=zisk-bundle /opt/zisk /opt/zisk
RUN chmod -R a+w /share/bflat /opt/libziskos

ENV HOME=/home/ci \
    LIBZISKOS_DIR=/opt/libziskos \
    HWLOC_COMPONENTS=-gl \
    SNARKJS_PATH=/opt/snarkjs/node_modules/snarkjs
ENV PATH=/opt/snarkjs/node_modules/.bin:$PATH
RUN mkdir -p /home/ci/.nuget/packages /home/ci/.cache /opt/zisk/cache /opt/zisk/provingKey \
 && ln -s /opt/zisk /home/ci/.zisk \
 && chmod -R 1777 /home/ci /opt/zisk/cache

WORKDIR /src
